# This is a template only. Real config is generated by scripts/setup_auth.py
# into auth_config.yaml (gitignored) — never edit password hashes by hand.
credentials:
  usernames:
    admin:
      email: admin@localhost
      name: Admin
      password: "<bcrypt hash generated by scripts/setup_auth.py>"
      logged_in: false
      failed_login_attempts: 0
cookie:
  name: backtester_dashboard_auth
  key: "<random signing key generated by scripts/setup_auth.py>"
  expiry_days: 7
